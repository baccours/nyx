<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Extends under the status bar (top padding is set from window insets in MainActivity),
         so the toolbar color and the status bar area are one continuous surface. -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/color_primary_container">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- Filter status card -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_status_card"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/selector_status_text"
                    android:text="@string/filter_off" />

                <com.baccours.nyx.components.SwipeToggleView
                    android:id="@+id/swipeToggle"
                    android:contentDescription="@string/filter_toggle_description"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Permission required warning card -->
            <LinearLayout
                android:id="@+id/permissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@drawable/bg_permission_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    app:drawableStartCompat="@drawable/ic_warning"
                    app:drawableTint="@color/color_error"
                    android:gravity="center_vertical"
                    android:text="@string/permission_required_title"
                    android:textColor="@color/color_error"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4sp"
                    android:text="@string/permission_required_body"
                    android:textColor="@color/color_on_error_container" />

            </LinearLayout>

            <!-- Dashboard: sliders, shown once the accessibility service is enabled -->
            <LinearLayout
                android:id="@+id/dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dashboard_card"
                    android:elevation="2dp"
                    android:padding="24dp">

                    <com.baccours.nyx.components.ControlSliderView
                        android:id="@+id/dimSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sliderLabel="@string/label_dimming_intensity"
                        app:sliderIcon="@drawable/ic_brightness"
                        app:sliderAccentColor="@color/dimming_accent" />

                    <com.baccours.nyx.components.ControlSliderView
                        android:id="@+id/blueSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        app:sliderLabel="@string/label_blue_light_filter"
                        app:sliderIcon="@drawable/ic_sun"
                        app:sliderAccentColor="@color/blue_light_accent" />

                    <!-- Color Temperature, Black Level and the system-mode switch only act through the
                         Blue Light Filter, so they are nested under it. MainActivity dims (but does not
                         disable) this block while the filter is at 0%, because they have no effect then. -->
                    <LinearLayout
                        android:id="@+id/blueLightOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Guide line, aligned with the centre of the 24dp icons above. -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:alpha="0.5"
                            android:background="@color/color_outline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp">

                            <com.baccours.nyx.components.ControlSliderView
                                android:id="@+id/tempSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:sliderLabel="@string/label_color_temperature"
                                app:sliderIcon="@drawable/ic_thermostat"
                                app:sliderAccentColor="@color/temperature_accent" />

                            <!-- 0% keeps true blacks (best for OLED); higher values add warm fill but lift blacks. -->
                            <com.baccours.nyx.components.ControlSliderView
                                android:id="@+id/blackSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                app:sliderLabel="@string/label_black_level"
                                app:sliderIcon="@drawable/ic_moon"
                                app:sliderAccentColor="@color/black_level_accent" />

                            <!-- Only shown on devices that have the system Night Light color transform. -->
                            <LinearLayout
                                android:id="@+id/systemModeGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/systemModeSwitch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:text="@string/system_mode_title"
                                    android:textColor="@color/color_on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/systemModeSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="2sp"
                                    android:text="@string/system_mode_summary_off"
                                    android:textColor="@color/color_on_surface_variant"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/runningIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_check_circle"
                    app:drawableTint="@color/color_primary"
                    android:text="@string/service_running"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
