<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Extends under status bar; top padding set via insets in MainActivity -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/color_primary_container">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- Filter status card -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_status_card"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/selector_status_text"
                    android:text="@string/filter_off" />

                <com.baccours.nyx.components.SwipeToggleView
                    android:id="@+id/swipeToggle"
                    android:contentDescription="@string/filter_toggle_description"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Service idle card -->
            <LinearLayout
                android:id="@+id/serviceIdleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2sp"
                    android:text="@string/service_idle_caption"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/disableServiceButton"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/disable_service"
                    android:textColor="@color/color_on_primary"
                    app:backgroundTint="@color/color_primary" />
            </LinearLayout>

            <!-- Permission required warning card -->
            <LinearLayout
                android:id="@+id/permissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@drawable/bg_permission_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    app:drawableStartCompat="@drawable/ic_warning"
                    app:drawableTint="@color/color_error"
                    android:gravity="center_vertical"
                    android:text="@string/permission_required_title"
                    android:textColor="@color/color_error"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4sp"
                    android:text="@string/permission_required_body"
                    android:textColor="@color/color_on_error_container" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/openAccessibilitySettingsButton"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="@string/open_accessibility_settings"
                    android:textColor="@color/color_on_error"
                    app:backgroundTint="@color/color_error" />

                <!-- Android 13+ only; visibility set in MainActivity -->
                <LinearLayout
                    android:id="@+id/restrictedSettingsHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4sp"
                        android:text="@string/permission_restricted_hint"
                        android:textColor="@color/color_on_error_container"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/openAppInfoButton"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/open_app_info"
                        android:textColor="@color/color_on_error_container" />
                </LinearLayout>

            </LinearLayout>

            <!-- Dashboard controls -->
            <LinearLayout
                android:id="@+id/dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dashboard_card"
                    android:elevation="2dp"
                    android:padding="24dp">

                    <com.baccours.nyx.components.ControlSliderView
                        android:id="@+id/dimSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sliderLabel="@string/label_dimming_intensity"
                        app:sliderIcon="@drawable/ic_brightness"
                        app:sliderAccentColor="@color/dimming_accent" />

                    <com.baccours.nyx.components.ControlSliderView
                        android:id="@+id/blueSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        app:sliderLabel="@string/label_blue_light_filter"
                        app:sliderIcon="@drawable/ic_sun"
                        app:sliderAccentColor="@color/blue_light_accent" />

                    <!-- Blue light filter sub-options -->
                    <LinearLayout
                        android:id="@+id/blueLightOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Vertical guide line -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:alpha="0.5"
                            android:background="@color/color_outline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="0dp">

                            <com.baccours.nyx.components.ControlSliderView
                                android:id="@+id/tempSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:sliderLabel="@string/label_color_temperature"
                                app:sliderIcon="@drawable/ic_thermostat"
                                app:sliderAccentColor="@color/temperature_accent" />

                            <!-- Black level slider -->
                            <com.baccours.nyx.components.ControlSliderView
                                android:id="@+id/blackSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                app:sliderLabel="@string/label_black_level"
                                app:sliderIcon="@drawable/ic_moon"
                                app:sliderAccentColor="@color/black_level_accent" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="2sp"
                                android:text="@string/black_level_hint"
                                android:textColor="@color/color_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
