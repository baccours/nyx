<resources>
    <!-- Plain AppCompat theme (no Material Components dependency). System bar colors and icon
         contrast come from enableEdgeToEdge() in MainActivity, which follows day/night. -->
    <style name="Theme.Nyx" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_container</item>
        <item name="colorAccent">@color/color_primary</item>
        <item name="colorControlActivated">@color/color_primary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
    </style>

    <style name="TextAppearance.Nyx.ToolbarTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textColor">@color/color_on_primary_container</item>
    </style>

    <style name="TextAppearance.Nyx.Headline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nyx.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nyx.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nyx.Value" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Nyx.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Nyx.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Nyx" parent="" />

    <style name="Widget.Nyx.WarningTitle">
        <item name="android:textAppearance">@style/TextAppearance.Nyx.Title</item>
        <item name="android:textColor">@color/color_error</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="drawableStartCompat">@drawable/ic_warning</item>
        <item name="drawableTint">@color/color_error</item>
    </style>

    <style name="Widget.Nyx.Button.Error" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColor">@color/color_on_error</item>
        <item name="backgroundTint">@color/color_error</item>
        <item name="drawableStartCompat">@drawable/ic_open_in_new</item>
        <item name="drawableTint">@color/color_on_error</item>
    </style>
</resources>
